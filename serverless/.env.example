COMFY_URL=http://127.0.0.1:8188
# Configure a read-only Hugging Face token as a RunPod secret/environment variable.
# Never commit a real token to this repository.
HF_TOKEN=
COMFY_WORKFLOW_PATH=/opt/trellis-worker/workflow_ui.json
COMFY_VIEW_NODE_IDS={"front":"2","rear":"3","left":"27","right":"29"}

# Exact private storage hosts allowed for signed source images / GLB uploads.
ALLOWED_IMAGE_HOSTS=your-project.supabase.co
ALLOWED_OUTPUT_HOSTS=your-project.supabase.co

# Canonical preprocessing.
REMBG_MODEL=u2net
CUTOUT_SIZE=1024
CUTOUT_INNER=896

JOB_TIMEOUT_SECONDS=1800
STALL_TIMEOUT_SECONDS=300  # applies only when the prompt is no longer active in ComfyUI's queue
MAX_GLB_RESPONSE_BYTES=52428800
